set unstable
# Docs recipes for nkp-partner-catalog.
# Authored content: docs/source (except generated trees). Docusaurus app: docs/site.
# Live publish is CI (Deploy Docs workflow → Pages artifact).

# Default sibling-repo root (parent of nkp-partner-catalog checkout).
# Catalog directory names: docs/source/config.yaml → catalogs[].id / expanded sources
sibling_root := justfile_directory() + "/../.."

# Remove generated / build artifacts under docs/ (keeps authored source + config.yaml).
[script]
clean:
    ROOT="{{ justfile_directory() }}"
    rm -rf \
      "$ROOT/source/applications" \
      "$ROOT/source/catalog-data.json" \
      "$ROOT/site/static/catalog-icons" \
      "$ROOT/site/static/catalog-data.json" \
      "$ROOT/site/static/cli" \
      "$ROOT/site/static/schemas/v1" \
      "$ROOT/site/static/offline" \
      "$ROOT/site/build" \
      "$ROOT/site/.docusaurus" \
      "$ROOT/.export-work" \
      "$ROOT/dist" \
      "$ROOT/.cache/nkp-cli" \
      "$ROOT/.cache/nkp-releases.json"
    if [ -d "$ROOT/site/src/data" ]; then
      find "$ROOT/site/src/data" -maxdepth 1 -type f -name '*.json' -delete
    fi
    if [ -d "$ROOT/source/cli" ]; then
      find "$ROOT/source/cli" -mindepth 1 -maxdepth 1 -type d -name '[0-9]*' -exec rm -rf {} +
    fi
    echo "Cleaned generated docs artifacts under $ROOT"

# Probe from lower of cliDocs/applications floors → .cache/nkp-releases.json
[script]
resolve-nkp-releases:
    ROOT="{{ justfile_directory() }}"
    if [ ! -d "$ROOT/site/node_modules/js-yaml" ]; then
        (cd "$ROOT/site" && npm ci --prefer-offline --ignore-scripts)
    fi
    node "$ROOT/scripts/resolve-nkp-releases.mjs"

# Alias kept for older docs / CI step names.
update-docs-config: resolve-nkp-releases

# Fetch Platform git refs + OCI full artifacts.
#   just fetch-catalog-sources /other/root
[script]
fetch-catalog-sources root=sibling_root:
    ROOT="{{ justfile_directory() }}"
    if [ ! -d "$ROOT/site/node_modules/js-yaml" ]; then
        (cd "$ROOT/site" && npm ci --prefer-offline --ignore-scripts)
    fi
    if [ ! -f "$ROOT/.cache/nkp-releases.json" ]; then
        just --justfile "$ROOT/justfile" --working-directory "$ROOT" resolve-nkp-releases
    fi
    node "$ROOT/scripts/fetch-catalog-sources.mjs" --root "{{ root }}"

# Crawl applications/ trees → catalog-data.json, applications/*, catalog-icons/.
#   just generate-catalog /other/root
[script]
generate-catalog root=sibling_root:
    ROOT="{{ justfile_directory() }}"
    if [ ! -f "$ROOT/.cache/nkp-releases.json" ]; then
        just --justfile "$ROOT/justfile" --working-directory "$ROOT" resolve-nkp-releases
    fi
    cd "$ROOT/site"
    if [ ! -d node_modules/js-yaml ]; then
        npm ci --prefer-offline --ignore-scripts
    fi
    node scripts/generate-catalog.js \
      --root "{{ root }}" \
      -o "$ROOT/source/catalog-data.json"

# Download nkp CLIs and regenerate source/cli/<minor>/ + commands.json.
[script]
generate-cli-docs:
    ROOT="{{ justfile_directory() }}"
    if [ ! -f "$ROOT/.cache/nkp-releases.json" ]; then
        just --justfile "$ROOT/justfile" --working-directory "$ROOT" resolve-nkp-releases
    fi
    if [ ! -d "$ROOT/site/node_modules/js-yaml" ]; then
        (cd "$ROOT/site" && npm ci --prefer-offline --ignore-scripts)
    fi
    node "$ROOT/scripts/generate-cli-docs.mjs"

[script]
_docs-prepare:
    ROOT="{{ justfile_directory() }}"
    mkdir -p "$ROOT/site/static/schemas/v1"
    rsync -a --delete "$ROOT/source/schemas/v1/" "$ROOT/site/static/schemas/v1/"
    if [ -f "$ROOT/source/catalog-data.json" ]; then
        cp "$ROOT/source/catalog-data.json" "$ROOT/site/static/catalog-data.json"
    else
        echo "WARN: missing source/catalog-data.json — run: just generate-catalog" >&2
    fi
    cd "$ROOT/site"
    npm ci --prefer-offline --ignore-scripts
    node "$ROOT/scripts/sync-docs-data.mjs"

[script]
_docs-export:
    ROOT="{{ justfile_directory() }}"
    mkdir -p "$ROOT/site/static/offline"
    if [ -z "${CHROME_PATH:-}" ]; then
      if [ -x "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" ]; then
        export CHROME_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
      elif command -v chromium >/dev/null 2>&1; then
        export CHROME_PATH="$(command -v chromium)"
      elif command -v chromium-browser >/dev/null 2>&1; then
        export CHROME_PATH="$(command -v chromium-browser)"
      elif command -v google-chrome >/dev/null 2>&1; then
        export CHROME_PATH="$(command -v google-chrome)"
      fi
    fi
    node "$ROOT/scripts/build-exports.mjs" --out-dir "$ROOT/site/static/offline"

# Resolve tags → fetch Platform sources → generate catalog + CLI.
[script]
_generate-docs:
    ROOT="{{ justfile_directory() }}"
    just --justfile "$ROOT/justfile" --working-directory "$ROOT" resolve-nkp-releases
    just --justfile "$ROOT/justfile" --working-directory "$ROOT" fetch-catalog-sources
    just --justfile "$ROOT/justfile" --working-directory "$ROOT" generate-catalog
    just --justfile "$ROOT/justfile" --working-directory "$ROOT" generate-cli-docs

# Full GitHub Pages build (generators + PDF export + docusaurus build).
[script]
docs-build base_url='/nkp-partner-catalog/':
    ROOT="{{ justfile_directory() }}"
    just --justfile "$ROOT/justfile" --working-directory "$ROOT" _generate-docs
    just --justfile "$ROOT/justfile" --working-directory "$ROOT" _docs-prepare
    just --justfile "$ROOT/justfile" --working-directory "$ROOT" _docs-export
    cd "$ROOT/site"
    BASE_URL="{{ base_url }}" npm run build

# Fast local preview: generators + prepare + build/serve (skips Chrome/PDF export).
# Pass args positionally (e.g. just docs-preview 127.0.0.1 3000 /) — keyword
# host=… form breaks under [script] on older just.
[script]
docs-preview host='0.0.0.0' port='3000' base_url='/':
    ROOT="{{ justfile_directory() }}"
    just --justfile "$ROOT/justfile" --working-directory "$ROOT" _generate-docs
    just --justfile "$ROOT/justfile" --working-directory "$ROOT" _docs-prepare
    cd "$ROOT/site"
    BASE_URL="{{ base_url }}" npm run build
    BASE_URL="{{ base_url }}" npm run docusaurus -- serve --dir build --host "{{ host }}" --port "{{ port }}"

# Serve an existing site/build (no generate / prepare / rebuild).
#   just docs-serve
#   just docs-serve 127.0.0.1 3000 /
[script]
docs-serve host='0.0.0.0' port='3000' base_url='/':
    ROOT="{{ justfile_directory() }}"
    if [ ! -f "$ROOT/site/build/index.html" ]; then
        echo "No site/build found. Run: just docs-preview {{ host }} {{ port }} {{ base_url }}" >&2
        exit 1
    fi
    cd "$ROOT/site"
    BASE_URL="{{ base_url }}" npm run docusaurus -- serve --dir build --host "{{ host }}" --port "{{ port }}"

# Full local preview including Export PDF/HTML (needs Chrome).
[script]
docs-local host='0.0.0.0' port='3000' base_url='/':
    ROOT="{{ justfile_directory() }}"
    just --justfile "$ROOT/justfile" --working-directory "$ROOT" _generate-docs
    just --justfile "$ROOT/justfile" --working-directory "$ROOT" _docs-prepare
    just --justfile "$ROOT/justfile" --working-directory "$ROOT" _docs-export
    cd "$ROOT/site"
    BASE_URL="{{ base_url }}" npm run build
    BASE_URL="{{ base_url }}" npm run docusaurus -- serve --dir build --host "{{ host }}" --port "{{ port }}"

# Offline exports only (PDF preferred + HTML secondary).
[script]
docs-offline:
    ROOT="{{ justfile_directory() }}"
    just --justfile "$ROOT/justfile" --working-directory "$ROOT" _generate-docs
    just --justfile "$ROOT/justfile" --working-directory "$ROOT" _docs-prepare
    just --justfile "$ROOT/justfile" --working-directory "$ROOT" _docs-export
    mkdir -p "$ROOT/dist"
    cp -f "$ROOT/site/static/offline/nkp-catalog-docs.pdf" \
          "$ROOT/site/static/offline/nkp-catalog-docs.html" \
          "$ROOT/dist/"
    echo "Offline exports in $ROOT/dist and $ROOT/site/static/offline"
