# Local docs tooling (devbox run from docs/)
.devbox/

# Node / Docusaurus
site/node_modules/
site/.docusaurus/
site/build/
site/.cache/
site/.eslintcache
*.tsbuildinfo

# Offline Export outputs (written by _docs-export / docs-offline)
site/static/offline/
.export-work/
dist/

# Downloaded nkp CLI binaries used by generate-cli-docs
.cache/nkp-cli/

# Local gh-pages clone staged by just docs-deploy (do not commit)
.docs-deploy/

# Synced at prepare time from source/; do not commit the static copy
site/static/catalog-data.json

# Logs / OS
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
.DS_Store
*.log
